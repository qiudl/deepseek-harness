{
  "name": "@deepseek-ai/dsh-slark-desktop-host",
  "description": "Single-machine DSH Host authority used by trusted Desktop brokers",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/desktop-host"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/host-control-client.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "node hub-upstream/sync.mjs --check && tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "lib/windows-startup.js",
    "lib/host-control-client.js",
    "lib/windows-host-pipe-worker-entry.js",
    "lib/windows-host-client-worker-entry.js",
    "lib/windows-embedding-identity-entry.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "hub-upstream/LICENSE",
    "hub-upstream/UPSTREAM.json",
    "hub-upstream/mcp.mjs",
    "hub-upstream/mcp.d.mts",
    "hub-upstream/skills-codec.mjs",
    "hub-upstream/skills-codec.d.mts",
    "hub-upstream/plugin-command.mjs",
    "hub-upstream/plugin-command.d.mts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-host-control-protocol": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "koffi": "^3.1.0",
    "yaml": "^2.9.0",
    "adm-zip": "0.6.0",
    "@deepseek-ai/dsh-app-boot": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-host-control-protocol": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:^",
    "@deepseek-ai/dsh-api-session-controller": "workspace:^",
    "@types/adm-zip": "0.5.7"
  },
  "imports": {
    "#hub-mcp": "./hub-upstream/mcp.mjs",
    "#hub-skills": "./hub-upstream/skills-codec.mjs",
    "#hub-plugin-command": "./hub-upstream/plugin-command.mjs"
  }
}
